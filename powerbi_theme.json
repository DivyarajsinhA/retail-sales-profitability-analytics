{
  "name": "Executive Retail Analytics Theme",
  "dataColors": [
    "#0F2942",
    "#0D7377",
    "#D97706",
    "#2563EB",
    "#059669",
    "#DC2626",
    "#7C3AED",
    "#64748B"
  ],
  "background": "#F8FAFC",
  "foreground": "#0F172A",
  "tableAccent": "#0D7377",
  "good": "#059669",
  "neutral": "#D97706",
  "bad": "#DC2626",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Bold",
      "color": "#0F2942"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F2942"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1E293B"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#475569"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "show": true,
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "transparency": 92
          }
        ]
      }
    }
  }
}